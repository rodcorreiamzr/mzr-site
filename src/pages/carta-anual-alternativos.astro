---
import Base from '../layouts/Base.astro';
const bodyHtml = "<style>\n:root{--navy-900:#0A1727;--navy-800:#14263F;--navy-700:#1D3557;--navy-600:#245595;--navy-500:#2E73AE;--navy-400:#4E90C6;--navy-300:#7BAED8;--navy-100:#D5E6F4;--navy-50:#EEF4FB;--gold-400:#C9A77C;--gold-500:#B08C58;--gold-600:#8C6C35;--gold-100:#F2E8D0;--white:#FDFCFB;--n-50:#F7F5F2;--n-100:#EFEDE8;--n-200:#D8D3CA;--n-400:#94918A;--n-500:#6B7A8D;--n-700:#3E4A5C;--n-900:#1A2028;}\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\nhtml{background:var(--navy-900);scroll-behavior:smooth}\nbody{font-family:'Work Sans',sans-serif;background:var(--n-100);color:var(--n-900);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}\n.inner{max-width:1200px;margin:0 auto;padding:0 48px}\n.reading{max-width:820px;margin:0 auto;padding:0 48px}\n@media(max-width:768px){.inner,.reading{padding:0 24px}}\n.overline{font-size:10px;font-weight:600;letter-spacing:.28em;text-transform:uppercase;color:var(--gold-600)}\n\n/* Navbar */\n.navbar{position:sticky;top:0;z-index:300;background:#1D3557;box-shadow:0 1px 0 rgba(255,255,255,.07)}\n.navbar-inner{display:flex;align-items:center;gap:30px;padding:0 clamp(20px,4vw,48px);overflow-x:auto;white-space:nowrap;scrollbar-width:none}\n.navbar-inner::-webkit-scrollbar{display:none}\n.navbar-logo{display:flex;align-items:center;text-decoration:none;flex-shrink:0}\n.navbar-logo-mark{height:16px;width:auto;display:block}\n.navbar-nav{display:flex;align-items:center;gap:26px;margin-left:24px}\n.navbar-nav a{font-weight:500;font-size:13px;text-decoration:none;color:rgba(255,255,255,.62);padding:20px 0;position:relative;transition:color .2s}\n.navbar-nav a::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:#C9A77C;transform:scaleX(0);transform-origin:left;transition:transform .28s}\n.navbar-nav a:hover{color:#C9A77C}.navbar-nav a:hover::after{transform:scaleX(1)}\n.navbar-cta{margin-left:auto;flex-shrink:0;background:transparent;border:1px solid rgba(201,167,124,.45);color:var(--gold-400);font-family:inherit;font-weight:500;font-size:12px;letter-spacing:.04em;padding:7px 16px;border-radius:6px;cursor:pointer;white-space:nowrap;transition:.2s}\n.navbar-cta:hover{background:rgba(201,167,124,.1)}\n.hamburger{display:none;align-items:center;justify-content:center;background:none;border:none;cursor:pointer;padding:6px}\n.mobile-menu{display:none;position:absolute;left:0;right:0;top:100%;z-index:299;background:rgba(18,34,56,.92);backdrop-filter:blur(14px);border-top:1px solid rgba(255,255,255,.07)}\n.mobile-menu.open{display:block}\n.mobile-nav-link{display:block;padding:15px clamp(20px,4vw,48px);font-weight:500;font-size:15px;color:rgba(255,255,255,.65);text-decoration:none;border-bottom:1px solid rgba(255,255,255,.05)}\n\n/* Header padr\u00e3o publica\u00e7\u00e3o */\n.pub-header{background:var(--navy-700);padding:72px 0 64px}\n.pub-tag{font-size:10px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-400);margin-bottom:16px}\n.pub-title{font-family:'Spectral',serif;font-weight:400;font-size:clamp(28px,3vw,44px);color:#fff;line-height:1.15;letter-spacing:-.02em}\n.pub-title .yr{color:var(--gold-400)}\n.previewnote{background:var(--gold-100);border-bottom:1px solid #E7D5A8;color:#6b5a2a;font-size:12.5px;line-height:1.6}\n.previewnote .inner{padding-top:11px;padding-bottom:11px}\n\n/* Doc sections (carta / highlights / m\u00eddia) */\n.doc{padding:76px 0}\n.doc.alt{background:var(--n-50);border-top:1px solid var(--n-200);border-bottom:1px solid var(--n-200)}\n.doc-title{font-family:'Spectral',serif;font-weight:400;font-size:clamp(26px,3vw,38px);color:var(--navy-700);line-height:1.18;letter-spacing:-.02em;margin:12px 0 30px}\n.prose p{font-size:16.5px;line-height:1.82;color:var(--n-700);margin-bottom:22px}\n.prose h3.sub{font-family:'Spectral',serif;font-weight:500;font-size:22px;color:var(--navy-800);margin:34px 0 18px;padding-top:10px;border-top:1px solid var(--n-200)}\nfigure.fig{margin:30px 0;background:#fff;border:1px solid var(--n-200);border-radius:12px;padding:22px 24px}\nfigure.fig img{width:100%;height:auto;display:block}\nfigure.fig figcaption{font-size:12px;color:var(--n-400);margin-top:14px;text-align:center}\n.dist-imgs{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:26px 0}\n@media(max-width:640px){.dist-imgs{grid-template-columns:1fr}}\n.dist-imgs figure{margin:0}\n\n/* Unic\u00f3rnios (Soma) cards */\n.soma-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:24px 0 30px}\n.soma-grid.one{grid-template-columns:1fr}\n@media(max-width:640px){.soma-grid{grid-template-columns:1fr}}\n.ucard{background:#fff;border:1px solid var(--n-200);border-radius:12px;padding:20px 22px}\n.ucard.lead{border-color:var(--gold-400);box-shadow:0 0 0 1px var(--gold-400)}\n.uc-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px}\n.uc-name{font-family:'Spectral',serif;font-weight:500;font-size:19px;color:var(--navy-800)}\n.uc-val{font-weight:600;font-size:14px;color:var(--gold-600);white-space:nowrap}\n.pill{display:inline-block;background:var(--navy-50);color:var(--navy-600);font-size:11px;font-weight:600;border-radius:6px;padding:2px 8px;margin-top:10px}\n.uc-desc{font-size:14px;line-height:1.62;color:var(--n-500);margin-top:12px}\n\n/* M\u00eddia */\n.mlist{list-style:none;display:flex;flex-direction:column;gap:12px}\n.mitem{background:#fff;border:1px solid var(--n-200);border-radius:12px;padding:18px 22px;transition:box-shadow .2s,border-color .2s}\n.mitem:hover{box-shadow:0 4px 20px rgba(29,53,87,.08);border-color:var(--navy-100)}\n.m-top{margin-bottom:8px}\n.m-veic{font-size:10px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-600)}\n.m-title{margin-bottom:9px}\n.mtitle{font-family:'Spectral',serif;font-weight:500;font-size:18px;color:var(--navy-800);text-decoration:none;line-height:1.3}\na.mtitle:hover{color:var(--gold-600);text-decoration:underline}\n.mtitle.nolink{color:var(--n-700)}\n.m-alloc{font-size:12.5px;color:var(--n-500);display:flex;flex-wrap:wrap;gap:7px;align-items:center}\n.m-alloc .a-emp{font-weight:600;color:var(--navy-800)}\n.m-alloc .a-fund{color:var(--gold-600);font-weight:500}\n.mdot{color:var(--n-200)}\n.mtag{font-size:9.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;border-radius:5px;padding:2px 8px;background:var(--navy-700);color:#fff}\n.mtag.exit{background:#2E7D4F}\n.mtag.exitp{background:var(--gold-600)}\n.mtag.uni{background:var(--navy-600)}\n\n/* Fund block */\n.fund{padding:80px 0;border-top:1px solid var(--n-200)}\n.fund-title{font-family:'Spectral',serif;font-weight:400;font-size:clamp(30px,3.6vw,44px);color:var(--navy-700);line-height:1.12;letter-spacing:-.02em;margin:12px 0 0}\n.fund-notes{margin:30px 0 0}\n.fund-notes p{font-size:16.5px;line-height:1.82;color:var(--n-700);margin:0 0 20px}\n.fund-notes p:last-child{margin-bottom:0}\n.facts{margin:34px 0 0}\n.facts-row{display:grid;gap:14px}\n.facts-stats{grid-template-columns:repeat(3,1fr);margin-bottom:14px}\n.facts-info{grid-template-columns:repeat(4,1fr)}\n@media(max-width:820px){.facts-info{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:520px){.facts-stats,.facts-info{grid-template-columns:1fr 1fr}.facts-stats .stat:nth-child(3){grid-column:1/-1}}\n.stat{background:var(--white);border:1px solid var(--n-200);border-radius:12px;padding:22px 24px}\n.stat .lab{font-size:10px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-600)}\n.stat .val{font-family:'Spectral',serif;font-weight:500;font-size:30px;color:var(--navy-700);line-height:1;margin-top:10px}\n.stat .val small{font-size:16px;color:var(--n-500);font-family:'Work Sans';font-weight:500}\n.info{background:var(--white);border:1px solid var(--n-200);border-radius:12px;padding:16px 20px}\n.info .lab{font-size:10px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--n-400)}\n.info .val{font-size:14.5px;font-weight:500;color:var(--n-900);line-height:1.4;margin-top:7px}\n.pf-head{margin:48px 0 18px}\n.pf-head h3{font-family:'Spectral',serif;font-weight:400;font-size:26px;color:var(--navy-700);margin-top:10px}\n.classbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}\n.classbar button{cursor:pointer;font-family:inherit;font-weight:500;font-size:13.5px;border:1px solid var(--n-200);background:var(--white);color:var(--n-500);padding:9px 18px;border-radius:999px;transition:.18s;display:flex;align-items:center;gap:9px}\n.classbar button:hover{border-color:var(--gold-500);color:var(--navy-700)}\n.classbar button[aria-selected=\"true\"]{background:var(--navy-700);color:#fff;border-color:var(--navy-700)}\n.classbar button .cc{font-size:11px;font-weight:600;background:var(--n-100);color:var(--n-500);border-radius:999px;padding:1px 8px}\n.classbar button[aria-selected=\"true\"] .cc{background:var(--gold-400);color:var(--navy-900)}\n.pf-body{display:grid;grid-template-columns:320px 1fr;gap:20px;align-items:start}\n@media(max-width:780px){.pf-body{grid-template-columns:1fr}}\n.glist{display:flex;flex-direction:column;gap:10px}\n.gcard{cursor:pointer;text-align:left;font-family:inherit;color:inherit;background:var(--white);border:1px solid var(--n-200);border-radius:12px;padding:13px 15px;display:flex;align-items:center;gap:13px;transition:box-shadow .2s,border-color .2s;width:100%}\n.gcard:hover{box-shadow:0 4px 20px rgba(29,53,87,.08);border-color:var(--navy-100)}\n.gcard[aria-selected=\"true\"]{border-color:var(--gold-400);box-shadow:0 0 0 1px var(--gold-400)}\n.gcard .lg{width:54px;height:36px;flex:0 0 54px;display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid var(--n-200);border-radius:7px;overflow:hidden}\n.gcard .lg img{max-width:46px;max-height:28px;object-fit:contain}\n.gcard .nm{font-weight:600;font-size:14px;color:var(--navy-800);line-height:1.25}\n.gcard .st{font-size:12.5px;color:var(--n-500);margin-top:3px}\n.gcard .st b{color:var(--navy-700);font-weight:600}\n.exbadge{display:inline-block;background:var(--navy-50);color:var(--navy-600);font-size:10.5px;font-weight:600;border-radius:5px;padding:1px 6px;margin-left:6px}\n.detail{background:var(--white);border:1px solid var(--n-200);border-radius:12px;padding:32px;min-height:260px}\n.detail .dh{display:flex;align-items:center;gap:18px;border-bottom:1px solid var(--n-200);padding-bottom:20px;margin-bottom:22px}\n.detail .dlg{width:104px;height:60px;flex:0 0 104px;display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid var(--n-200);border-radius:8px}\n.detail .dlg img{max-width:92px;max-height:48px;object-fit:contain}\n.detail .cls{font-size:10px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-600)}\n.detail h4{font-family:'Spectral',serif;font-weight:400;font-size:23px;color:var(--navy-800);line-height:1.25;margin:8px 0 0}\n.stats{display:flex;gap:36px;margin-top:16px}\n.stats .n{font-family:'Spectral',serif;font-weight:500;font-size:30px;color:var(--navy-700);line-height:1}\n.stats .l{font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--n-500);margin-top:6px}\n.invlab{font-size:10px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--n-400);margin-bottom:14px}\n.invgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(116px,1fr));gap:10px}\n.chip{background:#fff;border:1px solid var(--n-200);border-radius:10px;height:70px;display:flex;align-items:center;justify-content:center;padding:13px 18px}\n.chip img{width:100%;height:100%;object-fit:contain;display:block}\n.chip.t{color:var(--n-500);font-size:11.5px;text-align:center;font-weight:500;line-height:1.3}\n.inv-cell{display:flex;flex-direction:column;gap:5px}\n.chip.exit-total{border-color:#2E7D4F;box-shadow:0 0 0 1px #2E7D4F}\n.chip.exit-parcial{border-color:var(--gold-600);box-shadow:0 0 0 1px var(--gold-600)}\n.chip-ex{font-size:9.5px;font-weight:600;letter-spacing:.03em;text-transform:uppercase;text-align:center;line-height:1}\n.chip-ex.total{color:#2E7D4F}\n.chip-ex.parcial{color:var(--gold-600)}\n.empty{color:var(--n-500);font-size:14px;font-style:italic;padding:16px 0}\n/* ---- Gr\u00e1ficos reproduzidos (SVG) em box branco ---- */\n.charts{display:flex;flex-direction:column;gap:20px}\n.chart-card{margin:0;background:#fff;border:1px solid var(--n-200);border-radius:14px;padding:24px 26px 26px}\n.cc-head{display:flex;flex-direction:column;gap:6px;margin-bottom:20px}\n.cc-over{font-size:10px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-600)}\n.cc-title{font-family:'Spectral',serif;font-weight:500;font-size:19px;color:var(--navy-800)}\n.cc-body svg{width:100%;height:auto;display:block}\n.cc-foot{font-size:11px;color:var(--n-400);margin-top:12px}\n/* ---- Distrito (mosaico) ---- */\n.uni-grid,.fin-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:9px}\n.fin-block{margin-bottom:24px}\n.radar-band{display:grid;grid-template-columns:repeat(8,1fr);gap:9px;margin-bottom:22px;align-items:start}\n.radar-band:last-child{margin-bottom:0}\n.sec-logos{display:grid;gap:9px}\n.d-chip{height:56px;background:#fff;border:1px solid var(--n-200);border-radius:9px;display:flex;align-items:center;justify-content:center;padding:8px 10px}\n.d-chip img{max-width:100%;max-height:100%;object-fit:contain;filter:grayscale(1);opacity:.42}\n.d-chip.on{border-color:var(--gold-500);box-shadow:0 0 0 1px var(--gold-500),0 2px 8px rgba(140,108,53,.12)}\n.d-chip.on img{filter:none;opacity:1}\n.d-leg{display:flex;align-items:center;gap:8px}\n.d-key{width:22px;height:13px;border-radius:4px;border:1px solid var(--gold-500);box-shadow:0 0 0 1px var(--gold-500);background:#fff;flex:none}\n.sec-label{font-size:9.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-600);margin:0 0 8px}\n@media(max-width:700px){.uni-grid,.fin-grid,.radar-band{grid-template-columns:repeat(4,1fr)}.sec-group{grid-column:1/-1!important}}\n.ov-row{display:flex;align-items:center;gap:24px;margin-top:16px;padding-top:14px;border-top:1px solid var(--n-200)}\n.ov-l{font-weight:600;color:var(--navy-800);font-size:13.5px;flex:1}\n.ov-i{display:flex;flex-direction:column;align-items:center;gap:3px;min-width:120px}\n.ov-i em{font-style:normal;color:var(--n-500);font-size:11px;letter-spacing:.02em}\n.ov-i b{color:var(--navy-700);font-size:16px;font-variant-numeric:tabular-nums}\n@media(max-width:560px){.ov-i{min-width:80px}.ov-l{flex:0 0 100%;margin-bottom:6px}.ov-row{flex-wrap:wrap;gap:14px}}\n/* SVG text */\n.chart-card text{font-family:'Work Sans',sans-serif}\n.chart-card .ax{font-size:11px;fill:var(--n-400)}\n.chart-card .bl{font-size:11px;font-weight:600;fill:var(--navy-700)}\n.chart-card .bl,.chart-card .final{paint-order:stroke;stroke:#fff;stroke-width:3px;stroke-linejoin:round}\n.chart-card .bl.gold{fill:var(--gold-600)}\n.chart-card .final{font-family:'Spectral',serif;font-size:20px;font-weight:600;fill:var(--navy-700)}\n.chart-card .xlab{font-size:10.5px;fill:var(--n-500)}\n.chart-card .dn-t{font-size:12px;font-weight:600;fill:var(--n-500)}\n/* legendas de gr\u00e1fico */\n.clegend{display:flex;flex-wrap:wrap;gap:8px 20px;margin-bottom:16px;font-size:12px;color:var(--n-500)}\n.clegend span{display:inline-flex;align-items:center;gap:7px}\n.clegend .sq{width:11px;height:11px;border-radius:3px;display:inline-block}\n.clegend .ln{width:18px;height:0;border-top:2.5px solid var(--navy-700);display:inline-block}\n.clegend .ln.dash{border-top:2px dashed var(--navy-300)}\n/* donuts */\n.donuts{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n.donuts.d2{grid-template-columns:repeat(2,1fr);max-width:460px}\n@media(max-width:620px){.donuts,.donuts.d2{grid-template-columns:1fr}}\n.mini-t{font-size:12px;font-weight:600;color:var(--navy-800);text-align:center;margin-bottom:8px}\n.donut{display:flex;flex-direction:column;align-items:center}\n.donut svg{max-width:180px}\n.dn-leg{margin-top:12px;width:100%;max-width:210px}\n.lg-item{display:flex;align-items:center;gap:8px;font-size:12.5px;padding:3px 0}\n.lg-item .sw{width:11px;height:11px;border-radius:3px;flex-shrink:0}\n.lg-item .lg-l{color:var(--n-700);flex:1}\n.lg-item .lg-v{color:var(--navy-700);font-weight:600}\n/* tabela consolidada */\n.tblwrap{overflow-x:auto;border:1px solid var(--n-200);border-radius:10px}\n.ctab{border-collapse:collapse;width:100%;min-width:820px;font-size:12.5px}\n.ctab th{background:var(--navy-800);color:rgba(255,255,255,.85);font-weight:600;font-size:10px;letter-spacing:.04em;text-transform:uppercase;padding:11px 10px;text-align:right;white-space:nowrap}\n.ctab th:first-child,.ctab th:nth-child(2),.ctab th:nth-child(3){text-align:left}\n.ctab td{padding:9px 10px;border-bottom:1px solid var(--n-100);color:var(--n-700);white-space:nowrap}\n.ctab td.num{text-align:right;font-variant-numeric:tabular-nums}\n.ctab td.b{font-weight:600;color:var(--navy-800)}\n.ctab td.fn{font-weight:600;color:var(--navy-800);white-space:nowrap}\n.ctab .cbar{display:inline-block;width:3px;height:12px;border-radius:2px;margin-right:8px;vertical-align:-1px}\n.ctab td.pos{color:#2E7D4F;font-weight:600}\n.ctab td.neg{color:#B23B3B;font-weight:600}\n.ctab tr.sub td{background:var(--navy-50);font-weight:600;color:var(--navy-700);border-bottom:1px solid var(--navy-100)}\n.ctab tr.tot td{background:var(--navy-700);color:#fff;font-weight:700}\n.ctab tr.tot td.pos{color:#7FD1A0}\n.tnote{font-size:11px;color:var(--n-400);line-height:1.6;margin-top:12px}\n.tnote b{color:var(--n-500)}\n/* coluna do fundo travada (scroll lateral s\u00f3 nas demais) */\n.ctab th:first-child,.ctab td:first-child{position:sticky;left:0;z-index:2;box-shadow:1px 0 0 var(--n-200)}\n.ctab th:first-child{z-index:3;background:var(--navy-800)}\n.ctab td.fn{background:#fff}\n.ctab tr.sub td.fn{background:var(--navy-50)}\n.ctab tr.tot td.fn{background:var(--navy-700)}\n\n/* Footer */\nfooter{background:var(--navy-900);border-top:1px solid rgba(255,255,255,.07);padding:64px 0 32px}\n.footer-inner{max-width:1200px;margin:0 auto;padding:0 48px}\n.footer-top{display:grid;grid-template-columns:2fr 1fr 1fr;gap:48px;padding-bottom:48px;border-bottom:1px solid rgba(255,255,255,.07)}\n.footer-brand{display:flex;flex-direction:column;gap:20px}\n.footer-logo-mark{height:16px;width:auto;display:block}\n.footer-seals{display:flex;flex-direction:column;align-items:flex-start;gap:14px;margin-top:4px}\n.footer-seals-anbima{display:flex;align-items:center;gap:10px}\n.footer-seals-anbima img{height:62px;width:auto}\n.footer-seals>img{height:45px;width:auto}\n.footer-col-title{font-size:10px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.30);margin-bottom:16px}\n.footer-links{display:flex;flex-direction:column;gap:10px}\n.footer-links a{font-size:13px;color:rgba(255,255,255,.55);text-decoration:none;transition:color .2s}\n.footer-links a:hover{color:rgba(255,255,255,.90)}\n.footer-bottom{padding-top:28px;display:flex;align-items:flex-start;justify-content:space-between;gap:24px}\n.footer-legal{font-size:11px;color:rgba(255,255,255,.22);line-height:1.65;max-width:640px}\n.footer-copy{font-size:12px;color:rgba(255,255,255,.25);white-space:nowrap;flex-shrink:0;margin-top:2px}\n@media(max-width:768px){.navbar-nav{display:none}.navbar-cta{display:none}.hamburger{display:flex;margin-left:auto}.footer-top{grid-template-columns:1fr 1fr;gap:28px 20px}.footer-brand{grid-column:1/-1}.footer-bottom{flex-direction:column}.footer-inner{padding:0 24px}}\n\n</style>\n<header class=\"pub-header\"><div class=\"inner\">\n  <p class=\"pub-tag\">Carta Anual</p>\n  <h1 class=\"pub-title\">Allocation Alternativos PE/VC <span class=\"yr\">2026</span></h1>\n</div></header>\n\n<main>\n  <section class=\"doc\"><div class=\"reading\">\n    <p class=\"overline\">Update</p><h2 class=\"doc-title\">Mercado Privado Global</h2>\n    <div class=\"prose\"><p>Na carta do ano passado, coment\u00e1vamos que a ressaca enfrentada pela ind\u00fastria de Venture Capital desde 2022 parecia finalmente chegar ao fim. Um ano depois, essa percep\u00e7\u00e3o n\u00e3o apenas se confirmou, como deu lugar a uma nova fase do ciclo. O mercado voltou a acelerar de forma expressiva, impulsionado principalmente pela intelig\u00eancia artificial, com o volume global investido em Venture Capital mais do que dobrando no primeiro semestre de 2026 em rela\u00e7\u00e3o ao mesmo per\u00edodo do ano anterior. Ao mesmo tempo, a liquidez come\u00e7ou a retornar de forma consistente, refletida na reabertura do mercado de IPOs e no aumento relevante das aquisi\u00e7\u00f5es estrat\u00e9gicas, sinais importantes para uma ind\u00fastria que passou os \u00faltimos anos convivendo com escassez de sa\u00eddas para seus investidores.</p><figure class=\"chart-card wide\"><figcaption class=\"cc-head\"><span class=\"cc-over\">Mercado Global de VC</span><span class=\"cc-title\">Global Venture Dollar Volume \u2014 1S 2026</span></figcaption><div class=\"cc-body\"><div class=\"clegend\"><span><i class=\"sq\" style=\"background:#9CC0E0\"></i>Angel-Seed</span><span><i class=\"sq\" style=\"background:#2E7D6B\"></i>Early Stage</span><span><i class=\"sq\" style=\"background:#245595\"></i>Late Stage</span><span><i class=\"sq\" style=\"background:#B08C58\"></i>Technology Growth</span></div><svg viewBox=\"0 0 760 316\" role=\"img\" aria-label=\"stacked\"><line x1=\"50\" y1=\"276.0\" x2=\"748\" y2=\"276.0\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"44\" y=\"279.0\" text-anchor=\"end\" class=\"ax\">$0B</text><line x1=\"50\" y1=\"224.4\" x2=\"748\" y2=\"224.4\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"44\" y=\"227.4\" text-anchor=\"end\" class=\"ax\">$100B</text><line x1=\"50\" y1=\"172.8\" x2=\"748\" y2=\"172.8\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"44\" y=\"175.8\" text-anchor=\"end\" class=\"ax\">$200B</text><line x1=\"50\" y1=\"121.2\" x2=\"748\" y2=\"121.2\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"44\" y=\"124.2\" text-anchor=\"end\" class=\"ax\">$300B</text><line x1=\"50\" y1=\"69.6\" x2=\"748\" y2=\"69.6\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"44\" y=\"72.6\" text-anchor=\"end\" class=\"ax\">$400B</text><line x1=\"50\" y1=\"18.0\" x2=\"748\" y2=\"18.0\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"44\" y=\"21.0\" text-anchor=\"end\" class=\"ax\">$500B</text><rect x=\"62.1\" y=\"270.8\" width=\"39.3\" height=\"3.2\" rx=\"2\" fill=\"#9CC0E0\"/><rect x=\"62.1\" y=\"221.8\" width=\"39.3\" height=\"47.0\" rx=\"2\" fill=\"#2E7D6B\"/><rect x=\"62.1\" y=\"128.9\" width=\"39.3\" height=\"90.9\" rx=\"2\" fill=\"#245595\"/><rect x=\"62.1\" y=\"116.0\" width=\"39.3\" height=\"10.9\" rx=\"2\" fill=\"#B08C58\"/><text x=\"81.7\" y=\"291.0\" text-anchor=\"middle\" class=\"xlab\">H1 &#x27;21</text><rect x=\"125.5\" y=\"269.8\" width=\"39.3\" height=\"4.2\" rx=\"2\" fill=\"#9CC0E0\"/><rect x=\"125.5\" y=\"202.7\" width=\"39.3\" height=\"65.1\" rx=\"2\" fill=\"#2E7D6B\"/><rect x=\"125.5\" y=\"112.4\" width=\"39.3\" height=\"88.3\" rx=\"2\" fill=\"#245595\"/><rect x=\"125.5\" y=\"95.4\" width=\"39.3\" height=\"15.0\" rx=\"2\" fill=\"#B08C58\"/><text x=\"145.2\" y=\"291.0\" text-anchor=\"middle\" class=\"xlab\">H2</text><rect x=\"189.0\" y=\"265.7\" width=\"39.3\" height=\"8.3\" rx=\"2\" fill=\"#9CC0E0\"/><rect x=\"189.0\" y=\"211.5\" width=\"39.3\" height=\"52.2\" rx=\"2\" fill=\"#2E7D6B\"/><rect x=\"189.0\" y=\"139.3\" width=\"39.3\" height=\"70.2\" rx=\"2\" fill=\"#245595\"/><rect x=\"189.0\" y=\"126.4\" width=\"39.3\" height=\"10.9\" rx=\"2\" fill=\"#B08C58\"/><text x=\"208.6\" y=\"291.0\" text-anchor=\"middle\" class=\"xlab\">H1 &#x27;22</text><rect x=\"252.4\" y=\"271.9\" width=\"39.3\" height=\"2.1\" rx=\"2\" fill=\"#9CC0E0\"/><rect x=\"252.4\" y=\"230.6\" width=\"39.3\" height=\"39.3\" rx=\"2\" fill=\"#2E7D6B\"/><rect x=\"252.4\" y=\"202.2\" width=\"39.3\" height=\"26.4\" rx=\"2\" fill=\"#245595\"/><rect x=\"252.4\" y=\"197.1\" width=\"39.3\" height=\"3.2\" rx=\"2\" fill=\"#B08C58\"/><text x=\"272.1\" y=\"291.0\" text-anchor=\"middle\" class=\"xlab\">H2</text><rect x=\"315.9\" y=\"272.9\" width=\"39.3\" height=\"1.1\" rx=\"2\" fill=\"#9CC0E0\"/><rect x=\"315.9\" y=\"234.2\" width=\"39.3\" height=\"36.7\" rx=\"2\" fill=\"#2E7D6B\"/><rect x=\"315.9\" y=\"208.4\" width=\"39.3\" height=\"23.8\" rx=\"2\" fill=\"#245595\"/><rect x=\"315.9\" y=\"203.2\" width=\"39.3\" height=\"3.2\" rx=\"2\" fill=\"#B08C58\"/><text x=\"335.5\" y=\"291.0\" text-anchor=\"middle\" class=\"xlab\">H1 &#x27;23</text><rect x=\"379.3\" y=\"273.4\" width=\"39.3\" height=\"1.0\" rx=\"2\" fill=\"#9CC0E0\"/><rect x=\"379.3\" y=\"245.0\" width=\"39.3\" height=\"26.4\" rx=\"2\" fill=\"#2E7D6B\"/><rect x=\"379.3\" y=\"211.5\" width=\"39.3\" height=\"31.5\" rx=\"2\" fill=\"#245595\"/><rect x=\"379.3\" y=\"206.3\" width=\"39.3\" height=\"3.2\" rx=\"2\" fill=\"#B08C58\"/><text x=\"399.0\" y=\"291.0\" text-anchor=\"middle\" class=\"xlab\">H2</text><rect x=\"442.8\" y=\"272.9\" width=\"39.3\" height=\"1.1\" rx=\"2\" fill=\"#9CC0E0\"/><rect x=\"442.8\" y=\"234.2\" width=\"39.3\" height=\"36.7\" rx=\"2\" fill=\"#2E7D6B\"/><rect x=\"442.8\" y=\"205.8\" width=\"39.3\" height=\"26.4\" rx=\"2\" fill=\"#245595\"/><rect x=\"442.8\" y=\"201.7\" width=\"39.3\" height=\"2.1\" rx=\"2\" fill=\"#B08C58\"/><text x=\"462.5\" y=\"291.0\" text-anchor=\"middle\" class=\"xlab\">H1 &#x27;24</text><rect x=\"506.2\" y=\"272.9\" width=\"39.3\" height=\"1.1\" rx=\"2\" fill=\"#9CC0E0\"/><rect x=\"506.2\" y=\"241.9\" width=\"39.3\" height=\"29.0\" rx=\"2\" fill=\"#2E7D6B\"/><rect x=\"506.2\" y=\"200.7\" width=\"39.3\" height=\"39.3\" rx=\"2\" fill=\"#245595\"/><rect x=\"506.2\" y=\"195.5\" width=\"39.3\" height=\"3.2\" rx=\"2\" fill=\"#B08C58\"/><text x=\"525.9\" y=\"291.0\" text-anchor=\"middle\" class=\"xlab\">H2</text><rect x=\"569.7\" y=\"271.9\" width=\"39.3\" height=\"2.1\" rx=\"2\" fill=\"#9CC0E0\"/><rect x=\"569.7\" y=\"240.9\" width=\"39.3\" height=\"29.0\" rx=\"2\" fill=\"#2E7D6B\"/><rect x=\"569.7\" y=\"179.0\" width=\"39.3\" height=\"59.9\" rx=\"2\" fill=\"#245595\"/><rect x=\"569.7\" y=\"173.8\" width=\"39.3\" height=\"3.2\" rx=\"2\" fill=\"#B08C58\"/><text x=\"589.4\" y=\"291.0\" text-anchor=\"middle\" class=\"xlab\">H1 &#x27;25</text><rect x=\"633.1\" y=\"271.9\" width=\"39.3\" height=\"2.1\" rx=\"2\" fill=\"#9CC0E0\"/><rect x=\"633.1\" y=\"240.9\" width=\"39.3\" height=\"29.0\" rx=\"2\" fill=\"#2E7D6B\"/><rect x=\"633.1\" y=\"173.8\" width=\"39.3\" height=\"65.1\" rx=\"2\" fill=\"#245595\"/><rect x=\"633.1\" y=\"168.7\" width=\"39.3\" height=\"3.2\" rx=\"2\" fill=\"#B08C58\"/><text x=\"652.8\" y=\"291.0\" text-anchor=\"middle\" class=\"xlab\">H2</text><rect x=\"696.6\" y=\"269.8\" width=\"39.3\" height=\"4.2\" rx=\"2\" fill=\"#9CC0E0\"/><rect x=\"696.6\" y=\"218.2\" width=\"39.3\" height=\"49.6\" rx=\"2\" fill=\"#2E7D6B\"/><rect x=\"696.6\" y=\"29.9\" width=\"39.3\" height=\"186.3\" rx=\"2\" fill=\"#245595\"/><rect x=\"696.6\" y=\"22.1\" width=\"39.3\" height=\"5.7\" rx=\"2\" fill=\"#B08C58\"/><text x=\"716.3\" y=\"291.0\" text-anchor=\"middle\" class=\"xlab\">H1 &#x27;26</text></svg><div class=\"ov-row\"><span class=\"ov-l\">Overall Dollar Volume</span><span class=\"ov-i\"><em>HoH Change (%)</em><b>128%</b></span><span class=\"ov-i\"><em>YoY Change (%)</em><b>136%</b></span></div></div><figcaption class=\"cc-foot\">Fonte: PitchBook.</figcaption></figure><p>Entretanto, como frequentemente ocorre nos mercados, o retorno do entusiasmo tamb\u00e9m trouxe consigo comportamentos que lembram ciclos anteriores de euforia. Se h\u00e1 um ano destac\u00e1vamos que a escassez de capital havia proporcionado um ambiente de dilig\u00eancia mais criteriosa, valuations mais racionais e maior poder de negocia\u00e7\u00e3o para investidores, hoje j\u00e1 observamos, especialmente nos ativos ligados \u00e0 intelig\u00eancia artificial, processos competitivos cada vez mais acelerados, redu\u00e7\u00e3o significativa no tempo dispon\u00edvel para an\u00e1lise e uma crescente disputa de gestores simplesmente pelo direito de participar das rodadas. Em algumas estrat\u00e9gias, principalmente no mercado pr\u00e9-IPO, voltamos a observar um comportamento semelhante ao vivido em 2021, em que a expectativa de uma nova rodada ou de uma abertura de capital a um valuation ainda mais elevado acaba justificando pre\u00e7os cada vez menos fundamentados nos resultados atuais das empresas.</p><p>Embora boa parte do debate de mercado esteja concentrada na possibilidade de uma bolha nas empresas de tecnologia listadas em bolsa, nossa percep\u00e7\u00e3o \u00e9 que esse risco hoje merece aten\u00e7\u00e3o ainda maior no mercado privado. No mercado p\u00fablico, revis\u00f5es de expectativa costumam ser rapidamente incorporadas aos pre\u00e7os das a\u00e7\u00f5es, trazendo novamente os m\u00faltiplos para n\u00edveis mais compat\u00edveis com a gera\u00e7\u00e3o de resultados. J\u00e1 no mercado privado americano, observamos uma redu\u00e7\u00e3o gradual dessa disciplina. Empresas, n\u00e3o apenas de intelig\u00eancia artificial, mas tamb\u00e9m de rob\u00f3tica, defesa, computa\u00e7\u00e3o qu\u00e2ntica, infraestrutura energ\u00e9tica e tecnologias nucleares v\u00eam levantando sucessivas rodadas de capital em intervalos cada vez menores, muitas vezes a valuations extremamente elevados e ainda bastante dissociados da gera\u00e7\u00e3o de caixa. Naturalmente, isso n\u00e3o significa que essas empresas n\u00e3o possam justificar tais avalia\u00e7\u00f5es no futuro, mas refor\u00e7a a import\u00e2ncia de manter disciplina na sele\u00e7\u00e3o de gestores e na avalia\u00e7\u00e3o de pre\u00e7o, especialmente em um ambiente em que o acesso aos melhores ativos volta a ser tratado como vantagem competitiva por si s\u00f3.</p><figure class=\"chart-card wide\"><figcaption class=\"cc-head\"><span class=\"cc-over\">Crescimento de Valuation</span><span class=\"cc-title\">Empresas privadas (valuation) vs. Mag 7 (market cap) \u00b7 2023 \u2192 2026 YTD</span></figcaption><div class=\"cc-body\"><div class=\"clegend\"><span><i class=\"sq\" style=\"background:#1D3557\"></i>Empresas privadas (valuation)</span><span><i class=\"sq\" style=\"background:#B08C58\"></i>Mag 7 (market cap \u00b7 benchmark)</span></div><svg viewBox=\"0 0 760 340\" role=\"img\" aria-label=\"Crescimento de valuation 2023 \u2192 2026 YTD\"><line x1=\"46\" y1=\"300.0\" x2=\"746\" y2=\"300.0\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"40\" y=\"303.0\" text-anchor=\"end\" class=\"ax\">0%</text><line x1=\"46\" y1=\"233.0\" x2=\"746\" y2=\"233.0\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"40\" y=\"236.0\" text-anchor=\"end\" class=\"ax\">600%</text><line x1=\"46\" y1=\"166.0\" x2=\"746\" y2=\"166.0\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"40\" y=\"169.0\" text-anchor=\"end\" class=\"ax\">1.200%</text><line x1=\"46\" y1=\"99.0\" x2=\"746\" y2=\"99.0\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"40\" y=\"102.0\" text-anchor=\"end\" class=\"ax\">1.800%</text><line x1=\"46\" y1=\"32.0\" x2=\"746\" y2=\"32.0\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"40\" y=\"35.0\" text-anchor=\"end\" class=\"ax\">2.400%</text><rect x=\"71.0\" y=\"292.0\" width=\"50.0\" height=\"8.0\" rx=\"3\" fill=\"#B08C58\"/><text x=\"96.0\" y=\"286.0\" text-anchor=\"middle\" class=\"bl\">72%</text><text x=\"96.0\" y=\"316.0\" text-anchor=\"middle\" class=\"xlab\">Mag 7</text><rect x=\"171.0\" y=\"291.1\" width=\"50.0\" height=\"8.9\" rx=\"3\" fill=\"#1D3557\"/><text x=\"196.0\" y=\"285.1\" text-anchor=\"middle\" class=\"bl\">80%</text><text x=\"196.0\" y=\"316.0\" text-anchor=\"middle\" class=\"xlab\">ByteDance</text><rect x=\"271.0\" y=\"279.9\" width=\"50.0\" height=\"20.1\" rx=\"3\" fill=\"#1D3557\"/><text x=\"296.0\" y=\"273.9\" text-anchor=\"middle\" class=\"bl\">180%</text><text x=\"296.0\" y=\"316.0\" text-anchor=\"middle\" class=\"xlab\">Databricks</text><rect x=\"371.0\" y=\"275.7\" width=\"50.0\" height=\"24.3\" rx=\"3\" fill=\"#1D3557\"/><text x=\"396.0\" y=\"269.7\" text-anchor=\"middle\" class=\"bl\">218%</text><text x=\"396.0\" y=\"316.0\" text-anchor=\"middle\" class=\"xlab\">Stripe</text><rect x=\"471.0\" y=\"217.4\" width=\"50.0\" height=\"82.6\" rx=\"3\" fill=\"#1D3557\"/><text x=\"496.0\" y=\"211.4\" text-anchor=\"middle\" class=\"bl\">740%</text><text x=\"496.0\" y=\"316.0\" text-anchor=\"middle\" class=\"xlab\">OpenAI</text><rect x=\"571.0\" y=\"209.3\" width=\"50.0\" height=\"90.7\" rx=\"3\" fill=\"#1D3557\"/><text x=\"596.0\" y=\"203.3\" text-anchor=\"middle\" class=\"bl\">812%</text><text x=\"596.0\" y=\"316.0\" text-anchor=\"middle\" class=\"xlab\">SpaceX / xAI</text><rect x=\"671.0\" y=\"42.7\" width=\"50.0\" height=\"257.3\" rx=\"3\" fill=\"#1D3557\"/><text x=\"696.0\" y=\"36.7\" text-anchor=\"middle\" class=\"bl\">2.304%</text><text x=\"696.0\" y=\"316.0\" text-anchor=\"middle\" class=\"xlab\">Anthropic</text></svg></div><figcaption class=\"cc-foot\">Fonte: Coatue.</figcaption></figure><p>Grande parte dessa din\u00e2mica pode ser explicada pela concentra\u00e7\u00e3o sem precedentes do fluxo de capital. Apenas OpenAI e Anthropic captaram, juntas, aproximadamente USD 217 bilh\u00f5es no primeiro semestre, representando cerca de 43% de todo o capital de Venture Capital investido globalmente no per\u00edodo. No segundo trimestre, mais de 70% de todo o volume investido na ind\u00fastria foi destinado a empresas relacionadas \u00e0 intelig\u00eancia artificial, percentual significativamente superior ao observado um ano antes. A concentra\u00e7\u00e3o, que j\u00e1 destac\u00e1vamos na carta anterior, deixou de ser apenas uma caracter\u00edstica dos modelos fundacionais para se tornar uma das principais for\u00e7as que moldam toda a ind\u00fastria, influenciando desde a aloca\u00e7\u00e3o dos grandes investidores at\u00e9 a distribui\u00e7\u00e3o de talentos, infraestrutura computacional e aten\u00e7\u00e3o do mercado.</p><p>O s\u00edmbolo mais evidente dessa mudan\u00e7a talvez tenha sido a abertura de capital da SpaceX. Avaliada em aproximadamente USD 1,8 trilh\u00e3o em sua oferta p\u00fablica inicial, a empresa protagonizou o maior IPO da hist\u00f3ria, suficiente para que, sozinha, superasse todo o volume anual de exits observado em 2021, per\u00edodo que durante anos foi utilizado como refer\u00eancia do auge da euforia no Venture Capital. Menos de uma semana depois, anunciou a aquisi\u00e7\u00e3o da Anysphere, desenvolvedora do Cursor, por aproximadamente USD 60 bilh\u00f5es, estabelecendo tamb\u00e9m a maior aquisi\u00e7\u00e3o j\u00e1 realizada de uma startup. Em um \u00fanico trimestre, a mesma empresa protagonizou dois eventos hist\u00f3ricos, ilustrando como a combina\u00e7\u00e3o entre abund\u00e2ncia de capital e retorno da liquidez voltou a transformar a din\u00e2mica do mercado privado.</p><figure class=\"chart-card wide\"><figcaption class=\"cc-head\"><span class=\"cc-over\">Liquidez &amp; Exits</span><span class=\"cc-title\">VC exit activity by quarter</span></figcaption><div class=\"cc-body\"><div class=\"clegend\"><span><i class=\"sq\" style=\"background:#1D3557\"></i>Exit value</span><span><i class=\"ln\" style=\"border-top-color:#2BB8CC\"></i>Exit count</span><span><i class=\"sq\" style=\"background:#B08C58;border-radius:50%\"></i>Estimated exit count</span></div><svg viewBox=\"0 0 760 340\" role=\"img\" aria-label=\"VC exit activity by quarter\"><line x1=\"54\" y1=\"302.0\" x2=\"716\" y2=\"302.0\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"48\" y=\"305.0\" text-anchor=\"end\" class=\"ax\">$0B</text><line x1=\"54\" y1=\"231.0\" x2=\"716\" y2=\"231.0\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"48\" y=\"234.0\" text-anchor=\"end\" class=\"ax\">$500B</text><line x1=\"54\" y1=\"160.0\" x2=\"716\" y2=\"160.0\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"48\" y=\"163.0\" text-anchor=\"end\" class=\"ax\">$1,000B</text><line x1=\"54\" y1=\"89.0\" x2=\"716\" y2=\"89.0\" stroke=\"#E4DFD6\" stroke-width=\"1\"/><text x=\"48